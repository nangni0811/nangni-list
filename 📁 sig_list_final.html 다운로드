<script>
let asc = true;
function sortTable() {
  const table = document.getElementById("sigTable");
  const rows = Array.from(table.rows).slice(1);
  asc = !asc;
  rows.sort((a, b) => {
    const x = parseInt(a.cells[0].innerText);
    const y = parseInt(b.cells[0].innerText);
    return asc ? x - y : y - x;
  });
  document.getElementById("arrow").textContent = asc ? "▲" : "▼";
  rows.forEach(row => table.tBodies[0].appendChild(row));
}

function filterTable() {
  const input = document.getElementById("searchInput").value.toLowerCase();
  const rows = document.querySelectorAll("#sigTable tbody tr");
  rows.forEach(row => {
    const sig = row.cells[1].innerText.toLowerCase();
    row.style.display = sig.includes(input) ? "" : "none";
  });
}
</script>
