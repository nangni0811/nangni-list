      border-radius: 20px;
      border: 1px solid #ccc;
      font-size: 14px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    thead {
      background-color: #f9f9f9;
    }
    th {
      padding: 10px;
      font-size: 14px;
      cursor: pointer;
    }
    th span {
      margin-left: 6px;
      font-size: 12px;
    }
    td {
      padding: 10px;
      font-size: 14px;
      border-top: 1px solid #eee;
    }
    .sig-name {
      font-weight: bold;
    }
    .divider {
      padding: 0 6px;
      color: #ccc;
    }
  </style>
</head>
